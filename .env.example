# ---------------------------------------------------------------------------
# Road to Jaeger - environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
#
#   cp .env.example .env.local
#
# EVERY variable below is OPTIONAL. Road to Jaeger is local-first: with no
# Supabase configuration at all the app is 100% functional - curriculum,
# progress, study sessions, projects, notes and reminders are persisted in
# IndexedDB on the device and never leave it. Supabase only adds cross-device
# sync and is enabled from Settings -> Sync.
#
# SECURITY - READ THIS
#   * Only keys prefixed with NEXT_PUBLIC_ are inlined into the client bundle.
#     That is by design for the Supabase ANON key, which is safe to expose
#     *because* Row Level Security (supabase/migrations/0002_rls_policies.sql)
#     restricts every row to its owner.
#   * NEVER put the `service_role` key in this file, in any NEXT_PUBLIC_
#     variable, in the repository, or anywhere it can reach a browser or an
#     APK. The service_role key bypasses RLS entirely. This app has no server
#     component, so it must never need that key. `npm run verify` fails the
#     build if a service-role-looking secret is found in tracked files.
#   * `.env*` (except this example) is git-ignored.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase ANON / public key (the long JWT that starts with "eyJ...").
# NOT the service_role key. See the security note above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: 'local' (default, IndexedDB only) or 'supabase' (local + remote sync).
NEXT_PUBLIC_SYNC_MODE=local

# Optional: build metadata surfaced on the Settings screen.
NEXT_PUBLIC_BUILD_CHANNEL=dev

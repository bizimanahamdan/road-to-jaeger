{
  "name": "road-to-jaeger",
  "version": "1.0.0",
  "private": true,
  "description": "Road to Jaeger - an offline-first engineering learning system: math/physics foundations through software, electronics, embedded, mechanical, control, robotics and humanoid research.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/build-pwa.mjs",
    "preview": "node scripts/serve-out.mjs",
    "start": "node scripts/serve-out.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:resources": "node scripts/check-resources.mjs",
    "curriculum:stats": "node scripts/curriculum-stats.mjs",
    "curriculum:sql": "node scripts/export-curriculum-sql.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "cap:sync": "npm run build && cap sync android",
    "apk:debug": "bash scripts/build-apk.sh debug",
    "apk:release": "bash scripts/build-apk.sh release"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@supabase/supabase-js": "2.117.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "browserslist": [
    "chrome >= 70",
    "android >= 70",
    "edge >= 79",
    "firefox >= 67",
    "safari >= 12",
    "ios_saf >= 12"
  ]
}
